# Backend the relay polls.
BACKEND_URL=

# Same value as PRINT_RELAY_API_KEY in the Backend (Vercel env). Generate with: openssl rand -hex 32
PRINT_RELAY_API_KEY=

# Stable name for this relay; shows up in Pulse → Printers and on print-jobs.completedByRelay.
RELAY_ID=koege-warehouse

# Tuning (defaults shown)
POLL_INTERVAL_MS=2000
POLL_LIMIT=5
HEARTBEAT_INTERVAL_MS=30000
SEND_TIMEOUT_MS=30000

# IPP endpoint paths tried in order on the printer (IPP Everywhere standard first, then the Brother legacy path).
IPP_PATHS=/ipp/print,/ipp/port1

# If IPP fails on every path, also try writing the raw PDF to port 9100. Only safe for printers
# that render PDF natively (e.g. Brother HL-L5210DN); a host-based printer would print garbage.
IPP_RAW_FALLBACK=false

# debug | info | warn | error
LOG_LEVEL=info
