{
  "name": "print-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Warehouse LAN agent that delivers FinishFlow print jobs to Zebra (ZPL over TCP 9100) and IPP (PDF) printers without drivers.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/ipp.test.ts src/deliver.test.ts src/artifact.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
